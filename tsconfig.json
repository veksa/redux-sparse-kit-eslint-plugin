{
  "compilerOptions": {
    "rootDir": "src",
    "target": "es2019",
    "module": "es2015",
    "moduleResolution": "bundler",
    "lib": ["es2019"],
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"],
  "exclude": ["src/__tests__/**"]
}
